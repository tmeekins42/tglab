# Denoising a raw photograph.
#
# image() already inserted hot_pixel_repair and the demosaic, so `src` here is
# a finished RGB image and the noise left in it is the broad-band sensor kind.

src = image("test")

developed = params(basic_adjust)(src)

luma   = slider("luma", 0.0, 0.08, 0.02)
chroma = slider("chroma", 0.0, 0.25, 0.08)
levels = slider("levels", 1, 6, 4)

clean = wavelet_denoise(developed, luma = luma, chroma = chroma, levels = levels)

display(developed,   "original")
display(clean, "denoised")
